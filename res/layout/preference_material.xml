<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="?android:attr/selectableItemBackground" android:clipToPadding="false">

    <!-- Icon Frame -->
    <FrameLayout android:id="@android:id/icon_frame" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="16dp" android:visibility="gone">

        <ImageView android:id="@android:id/icon" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" />

    </FrameLayout>

    <!-- Title and Summary -->
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">

        <TextView android:id="@android:id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="?android:attr/textColorPrimary" android:ellipsize="marquee" android:singleLine="true" tools:text="Preference Title" />

        <TextView android:id="@android:id/summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?android:attr/textColorSecondary" android:maxLines="2" tools:text="Preference summary text" />

    </LinearLayout>

    <!-- Widget Frame (Switch, etc.) -->
    <FrameLayout android:id="@android:id/widget_frame" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:gravity="end|center_vertical" />

</LinearLayout>
