<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:layout_marginBottom="8dp" android:gravity="center_vertical" android:background="@drawable/bg_preference_card" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">

    <!-- Icon -->
    <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="16dp" android:background="@drawable/bg_icon_circle">

        <ImageView android:id="@+id/iv_log_icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_export" android:tint="@color/icon_on_primary" android:contentDescription="@null" />

    </FrameLayout>

    <!-- Text content -->
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

        <TextView android:id="@+id/tv_file_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="?android:attr/textColorPrimary" android:maxLines="1" android:ellipsize="end" />

        <TextView android:id="@+id/tv_file_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?android:attr/textColorSecondary" android:maxLines="1" android:ellipsize="end" />

    </LinearLayout>

    <!-- More menu icon -->
    <ImageView android:id="@+id/iv_more_options" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_more_vert" android:tint="?android:attr/textColorSecondary" android:contentDescription="@null" android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="2dp" />

</LinearLayout>
