    <ImageView android:id="@+id/stat_icon" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:tint="?android:attr/textColorPrimary" android:visibility="gone" />

    <TextView android:id="@+id/stat_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CPU" android:textAllCaps="true" android:textSize="11sp" android:letterSpacing="0.05" android:textStyle="bold" android:textColor="?android:attr/textColorSecondary" android:layout_marginTop="4dp" android:fontFamily="sans-serif-medium" />

