<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingHorizontal="10dp" android:paddingVertical="6dp" android:minWidth="48dp">

    <!-- Label (FPS, CPU, etc) -->
    <TextView android:id="@+id/stat_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CPU" android:textAllCaps="true" android:textSize="9sp" android:letterSpacing="0.05" android:textStyle="bold" android:textColor="@color/overlay_label" android:fontFamily="sans-serif-medium" />

    <!-- Value (60, 45%, etc) -->
    <TextView android:id="@+id/stat_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="45%" android:textSize="14sp" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" android:fontFamily="sans-serif-medium" />

    <!-- Icon (hidden by default) -->
    <ImageView android:id="@+id/stat_icon" android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:tint="@color/overlay_label" android:visibility="gone" />

</LinearLayout>
